APP_ORIGIN=http://localhost:3000
APPWRITE_ENDPOINT=https://YOUR_REGION.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=YOUR_PROJECT_ID
APPWRITE_API_KEY=YOUR_SERVER_ONLY_API_KEY
APPWRITE_DATABASE_ID=stillroom
APPWRITE_BUCKET_ID=stillroom
# Generate a random secret of at least 32 characters; never expose it to clients.
RATE_LIMIT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Only one host with persistent shared .private storage is supported.
STILLROOM_COORDINATION_MODE=single-host
